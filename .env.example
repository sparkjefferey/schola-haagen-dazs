# 沙藏学馆 环境变量示例
# 复制本文件为 .env 并填入真实值，docker compose 会自动读取。
# .env 已被 .gitignore 忽略，不会上传到 GitHub。

# 首次公网部署必填：用于注册首任管理员。注册完成后清空并重启容器。
ADMIN_INVITE=

# 可选：未互证同侪的每日私信限额（两人完成同侪互证后无限，管理员不受限）。默认 5。
PM_DAILY_LIMIT=5

# 可选：每个已登录账号每 10 分钟的学术检索次数。不是全站共享限制。
SCHOLAR_CLIENT_RATE_LIMIT=20

# 可选：新账号可投稿前的冷静期（小时）。
COOL_DOWN_HOURS=24

# 仅本地演示数据需要；生产部署不会自动播种这些账号。
# SEED_ADMIN_PW=至少16位的本地演示口令
# SEED_SOKRATES_PW=至少16位的本地演示口令
# SEED_PLATO_PW=至少16位的本地演示口令

# 可选：CORE 学术源免费密钥（启用中文开放论文检索）
# 注册地址：https://core.ac.uk/services/api （免费，非商业用途）
# 拿到 key 后填在等号右边，去掉下面行的注释即可：
# SCHOLAR_CORE_KEY=你的CORE免费key
