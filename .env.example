# 沙藏学馆 环境变量示例
# 复制本文件为 .env 并填入真实值，docker compose 会自动读取。
# .env 已被 .gitignore 忽略，不会上传到 GitHub。

# 可选：后续管理者邀请码（首任管理员无需）
ADMIN_INVITE=

# 可选：未互证同侪的每日私信限额（两人完成同侪互证后无限，管理员不受限）。默认 5。
PM_DAILY_LIMIT=5

# 可选：CORE 学术源免费密钥（启用中文开放论文检索）
# 注册地址：https://core.ac.uk/services/api （免费，非商业用途）
# 拿到 key 后填在等号右边，去掉下面行的注释即可：
# SCHOLAR_CORE_KEY=你的CORE免费key
