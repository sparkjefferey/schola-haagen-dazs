# 沙藏学馆 · 环境变量示例
# 复制为 .env 并填入真实值，再 `docker compose up -d` 即可生效（docker compose 默认读取同目录 .env）。
# 所有变量均可留空；留空时对应功能自动降级（不报错）。

# 首任/后续管理者注册邀请码（首任建立后建议清空并重启容器）
ADMIN_INVITE=

# 私信每日限额（普通学者，未互证时）
PM_DAILY_LIMIT= 5

# 学者客户端限流（每小时）
SCHOLAR_CLIENT_RATE_LIMIT=20

# 新学者投稿冷静期（小时），0 表示关闭
COOL_DOWN_HOURS=24

# 中文开放论文检索（CORE.ac.uk 免费 key，可选）
SCHOLAR_CORE_KEY=

# ---- 系统邮件（SMTP，可选）----
# 未配置时，弱口令等系统提醒仅走站内「讯息」，不发真邮件。
# 推荐方案（零成本、免域名、能发任意邮箱）：
#   QQ 邮箱  : host=smtp.qq.com  port=465(SSL)  user=<你的QQ邮箱全名 如 123456@qq.com>  pass=<QQ邮箱授权码,非登录密码>  from=同 user
#     → 先在 QQ 邮箱网页「设置→账户→开启 POP3/SMTP 服务」并生成 16 位授权码。
# 其他可选服务：
#   Resend  : host=smtp.resend.com  port=465  user=resend        pass=<API Key>  from=Schola <noreply@你的域名>（需验证域名）
#   Gmail   : host=smtp.gmail.com  port=465  user=<Gmail>  pass=<应用专用密码>  from=同 user
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
